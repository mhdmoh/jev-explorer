# Nginx site template for Jev Explorer.
# This file is not installed by the deploy script and is not the live server config.
# Intended public host: jev-explorer.mhdmoh.com → 127.0.0.1:8510.
# The container listens on 8000. Confirm the live proxy with `sudo nginx -T`.
# Copy to the server (e.g. /etc/nginx/sites-available/jev-explorer) and replace:
#   __DOMAIN__      public hostname
#   __HOST_PORT__   local Docker published port (e.g. 8510)
#
# Then:
#   sudo ln -s /etc/nginx/sites-available/jev-explorer /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d __DOMAIN__

upstream jev_explorer_api {
    server 127.0.0.1:__HOST_PORT__;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location / {
        proxy_pass http://jev_explorer_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        # Overwrite (do not append) client-supplied forwarding headers so the
        # app can trust these values when the TCP peer is Nginx/Docker only.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }
}
