# Nginx site template for AgentGuard
# Copy to the server (e.g. /etc/nginx/sites-available/agentguard) and replace:
#   __DOMAIN__      public hostname
#   __HOST_PORT__   local Docker published port (e.g. 8510)
#
# Then:
#   sudo ln -s /etc/nginx/sites-available/agentguard /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d __DOMAIN__

upstream agentguard_api {
    server 127.0.0.1:__HOST_PORT__;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location / {
        proxy_pass http://agentguard_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        # Overwrite (do not append) client-supplied forwarding headers so the
        # app can trust these values when the TCP peer is Nginx/Docker only.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }
}
