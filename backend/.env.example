# Jev Decision API (optional — without it the app runs in DEMO MODE)
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_BASE_URL=https://jevtypesafeai.com/api/v1/decide
JEV_TIMEOUT_SECONDS=30

# App
APP_ENV=development
LOG_LEVEL=INFO
POLICY_VERSION=1.0
DEMO_WORKSPACE=demo/workspace

# Browser origins allowed to call the API. Comma-separated. Do not use "*".
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Deterministic policy thresholds
AUTO_EXECUTE_MAX_RISK=2.0
AUTO_EXECUTE_MIN_SAFE=0.90
CONFIRM_MAX_RISK=3.0
CONFIRM_MIN_SAFE=0.50
BLOCK_MIN_RISK=4.0

# Outbound Jev API rate limits (live calls only; DEMO MODE unrestricted)
# Layer 1: per anonymous browser cookie (jev_anon_id)
# Layer 2: per public client IP (abuse protection)
RATE_LIMIT_ENABLED=true
ANONYMOUS_RATE_LIMIT_REQUESTS=3
ANONYMOUS_RATE_LIMIT_WINDOW_SECONDS=18000
IP_RATE_LIMIT_REQUESTS=20
IP_RATE_LIMIT_WINDOW_SECONDS=3600
# jev_anon_id lifetime. The server will not make this shorter than the anonymous window.
# ANONYMOUS_ID_COOKIE_MAX_AGE_SECONDS=31536000
# TCP peers allowed to set X-Real-IP / X-Forwarded-For (loopback + Docker bridge)
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128,172.16.0.0/12
